diff --git a/plugins/org.eclipse.elk.alg.layered/src/org/eclipse/elk/alg/layered/compound/spline_chain.rs b/plugins/org.eclipse.elk.alg.layered/src/org/eclipse/elk/alg/layered/compound/spline_chain.rs
